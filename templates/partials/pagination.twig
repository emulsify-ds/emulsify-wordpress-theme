{% set pages = pagination.pages|default([]) %}
{% if pages is not empty %}
    <nav class="pagination" aria-label="Pagination">
        <ul class="pagination__items">
            {% if pagination.prev|default(null) %}
                <li class="pagination__item pagination__item--previous">
                    <a class="pagination__link" href="{{ pagination.prev.link }}">Previous</a>
                </li>
            {% endif %}

            {% for page in pages %}
                <li class="pagination__item{% if page.current|default(false) %} pagination__item--current{% endif %}">
                    {% if page.link|default(null) %}
                        <a class="pagination__link {{ page.class|default('') }}" href="{{ page.link }}">{{ page.title }}</a>
                    {% else %}
                        <span class="pagination__link {{ page.class|default('') }}" aria-current="page">{{ page.title }}</span>
                    {% endif %}
                </li>
            {% endfor %}

            {% if pagination.next|default(null) %}
                <li class="pagination__item pagination__item--next">
                    <a class="pagination__link" href="{{ pagination.next.link }}">Next</a>
                </li>
            {% endif %}
        </ul>
    </nav>
{% endif %}
