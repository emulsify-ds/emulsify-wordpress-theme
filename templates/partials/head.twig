{# Document head fallback. Keep wp_head() here so plugin, block, and WordPress
   assets continue to enqueue through normal core hooks. #}
<head>
    <meta charset="{{ site.charset|default('UTF-8') }}" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {% do action('get_header') %}
    {{ function('wp_head') }}
</head>
