{% extends '@templates/layouts/base.twig' %}

{% block content %}
    {% if post|default(null) %}
        <article {{ add_attributes({
            class: ['entry', 'entry--' ~ post.type|default('post')],
            id: post.id|default(null) ? 'post-' ~ post.id : null
        }) }}>
            {% if post.thumbnail|default(null) and post.thumbnail.src|default(null) %}
                <figure class="entry__media">
                    <img src="{{ post.thumbnail.src|resize(1200, 675) }}" alt="{{ post.thumbnail.alt|default(post.title) }}" />
                </figure>
            {% endif %}

            <header class="entry__header">
                <h1 class="entry__title">{{ post.title }}</h1>

                {% if post.author|default(null) or post.date|default(null) %}
                    <div class="entry__meta">
                        {% if post.author|default(null) %}
                            <span class="entry__author">
                                <a href="{{ post.author.path|default('#') }}">{{ post.author.name }}</a>
                            </span>
                        {% endif %}

                        {% if post.date|default(null) %}
                            <time class="entry__date" datetime="{{ post.date|date('Y-m-d H:i:s') }}">{{ post.date }}</time>
                        {% endif %}
                    </div>
                {% endif %}
            </header>

            <div class="entry__content">
                {{ post.content }}
            </div>

            {% set comments = post.comments|default([]) %}
            {% if comments is not empty or post.comment_status|default('closed') != 'closed' %}
                <section class="comments" aria-label="Comments">
                    {% if comments is not empty %}
                        <h2 class="comments__title">Comments</h2>

                        {% for comment in comments %}
                            {% include '@templates/partials/comment.twig' with {
                                comment: comment
                            } only %}
                        {% endfor %}
                    {% endif %}

                    {% if post.comment_status|default('closed') != 'closed' %}
                        {% include '@templates/partials/comment-form.twig' with {
                            post: post,
                            user: user|default(wp.user|default(null)),
                            site: site
                        } only %}
                    {% endif %}
                </section>
            {% endif %}
        </article>
    {% else %}
        <p>No post content was found.</p>
    {% endif %}
{% endblock %}
