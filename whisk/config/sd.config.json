{
  "source": [
    "dist/tokens/transformed.tokens.json"
  ],
  "log": {
    "verbosity": "verbose"
  },
  "platforms": {
    "scss": {
      "transforms": [
        "attribute/cti",
        "name/kebab",
        "time/seconds",
        "html/icon",
        "color/css"
      ],
      "files": [
        {
          "destination": "src/tokens/_tokens.scss",
          "format": "scss/variables",
          "mapName": "my-tokens"
        }
      ]
    }
  }
}