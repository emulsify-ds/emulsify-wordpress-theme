{% extends 'templates/layouts/base.twig' %}

{% block content %}
    {% for post in posts %}
        {% include ['templates/partials/tease-' ~ post.type ~ '.twig', 'templates/partials/tease.twig'] %}
    {% endfor %}

    {% include 'templates/partials/pagination.twig' with {
        pagination: posts.pagination({
            show_all: false,
            mid_size: 3,
            end_size: 2
        })
    } %}
{% endblock %}
