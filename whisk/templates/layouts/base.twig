<!doctype html>
<html {{ site.language_attributes|default('') }}>
    {% block head %}
        {% include '@templates/partials/head.twig' %}
    {% endblock %}

    <body {{ add_attributes({ class: body_class|default('') }) }}>
        {{ function('wp_body_open') }}
        <a class="skip-link screen-reader-text" href="#content">Skip to content</a>

        <header class="site-header" role="banner">
            <div class="site-header__inner">
                {% block header %}
                    <a class="site-header__brand" href="{{ site.url|default('/') }}" rel="home">
                        {{ site.name|default('') }}
                    </a>

                    {% set menu_items = menu|default(null) ? menu.get_items : [] %}
                    {% if menu_items is not empty %}
                        <nav class="site-header__navigation" aria-label="Primary navigation">
                            {% include '@templates/partials/menu.twig' with {
                                items: menu_items,
                                menu_class: 'menu menu--primary'
                            } only %}
                        </nav>
                    {% endif %}
                {% endblock %}
            </div>
        </header>

        <main id="content" class="site-main" tabindex="-1">
            {% if title|default(null) %}
                <header class="page-header">
                    <h1 class="page-header__title">{{ title }}</h1>
                </header>
            {% endif %}

            {% block content %}{% endblock %}
        </main>

        {% block footer %}
            {% include '@templates/partials/footer.twig' %}
        {% endblock %}

        {{ function('wp_footer') }}
        {% do action('get_footer') %}
    </body>
</html>
