{% extends '@templates/layouts/base.twig' %}

{% block content %}
    {% if post|default(null) %}
        <form class="password-form" action="{{ site.link|default('') }}/wp-login.php?action=postpass" method="post">
            <label for="pwbox-{{ post.id }}">Password</label>
            <input class="password-form__input" name="post_password" id="pwbox-{{ post.id }}" type="password" autocomplete="current-password" />
            <button class="password-form__submit" type="submit" name="Submit">Submit</button>
        </form>
    {% else %}
        <p>This content is password protected.</p>
    {% endif %}
{% endblock %}
