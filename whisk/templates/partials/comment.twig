{% if comment|default(null) %}
    <article class="comment" id="comment-{{ comment.id|default('') }}">
        {% if comment.author.name|default(null) %}
            <header class="comment__header">
                <h3 class="comment__author">{{ comment.author.name }}</h3>
            </header>
        {% endif %}

        {% if comment.content|default(null) %}
            <div class="comment__content">{{ comment.content|wpautop }}</div>
        {% endif %}

        {% set children = comment.children|default([]) %}
        {% if children is not empty %}
            <div class="comment__children">
                {% for child in children %}
                    {% include '@templates/partials/comment.twig' with {
                        comment: child
                    } only %}
                {% endfor %}
            </div>
        {% endif %}
    </article>
{% endif %}
