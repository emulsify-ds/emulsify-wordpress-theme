{
  "name": "emulsify-ds/emulsify-wordpress",
  "description": "Timber-first WordPress parent theme for Emulsify that generates child themes with Emulsify Core 4, Vite, Storybook, and Twig",
  "type": "wordpress-theme",
  "homepage": "https://www.emulsify.info",
  "license": "GPL-2.0-only",
  "authors": [
      {
          "name": "Callin Mullaney",
          "email": "callin@fourkitchens.com"
      },
      {
        "name": "Mike Goulding",
        "email": "mike.goulding@fourkitchens.com"
    }
  ],
  "require": {
      "timber/timber": "^2.3"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true
    }
  }
}
